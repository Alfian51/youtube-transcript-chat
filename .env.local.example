# YouTube Data API v3 (Opsional: jika kosong, sistem otomatis memakai fallback public search scraping)
# Dapatkan dari Google Cloud Console > APIs & Services > Credentials
YOUTUBE_API_KEY=

# API Key untuk AI (Gemini atau OpenAI)
AI_API_KEY=your_api_key_here

# Free Anti-Bot Transcript API untuk cloud/Vercel (dapatkan gratis di https://supadata.ai)
SUPADATA_API_KEY=

# Opsi provider AI: 'gemini' atau 'openai' (opsional, auto-detect berdasarkan format key)
AI_PROVIDER=gemini
